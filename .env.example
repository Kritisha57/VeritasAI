CHILD_CHUNK_TOKENS=300
CHUNK_OVERLAP_TOKENS=40
VLM_MODEL=ibm-granite/granite-docling-258M
DOCLING_IMAGE_SCALE=2.0
DOCLING_DO_OCR=false

